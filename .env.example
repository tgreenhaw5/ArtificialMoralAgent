# ArtificialMoralAgent settings. `ama init` writes these to ~/.ama/.env for you.
# ---- models (LiteLLM strings) ----
AMA_MODEL=gemini/gemini-3.5-flash-lite        # default: Gemini Flash-Lite (free key: /help/gemini-key)
# AMA_ARBITER_MODEL=anthropic/claude-sonnet-5-5  # optional stronger model for the Chief Moral Arbiter
# AMA_TRIAGE_MODEL=
AMA_EMBED_MODEL=gemini/gemini-embedding-001
AMA_EMBED_DIM=768
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434
# AMA_ALLOWED_MODELS=gemini/gemini-3.5-flash-lite,gemini/gemini-3.8-flash,anthropic/claude-sonnet-5-5
# ---- database (blank = SQLite in ~/.ama) ----
AMA_DATABASE_URL=
# ---- server ----
AMA_HOST=127.0.0.1
AMA_PORT=8410
# AMA_ROOT_PATH=/ama          # when served under a subpath behind a reverse proxy
# AMA_TRUST_PROXY=true        # use X-Forwarded-For for client IPs (only behind your own proxy)
# AMA_CORS_ORIGINS=https://example.org
# ---- public demo (guests evaluate on your key, within limits) ----
AMA_PUBLIC_DEMO=false
AMA_DEMO_PER_IP_PER_DAY=5
AMA_DEMO_PER_DAY=200
AMA_DEMO_BUDGET_USD_PER_DAY=2.00
# ---- knowledge base: browsable by guests until this date (blank = always, off = never) ----
AMA_KB_PUBLIC_UNTIL=
AMA_RATE_PER_MINUTE=30
AMA_MAX_DILEMMA_CHARS=4000
